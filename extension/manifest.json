{
  "manifest_version": 2,
  "name": "Thunderbird MCP Bridge",
  "version": "0.3.0",
  "description": "Thin relay between a local MCP server and Thunderbird. It reads, flags, tags and drafts mail; it cannot remove or transmit mail.",
  "browser_specific_settings": {
    "gecko": {
      "id": "thunderbird-mcp-bridge@local.invalid",
      "strict_min_version": "140.0",
      "update_url": "https://github.com/shizuku0901/thunderbird-mcp/releases/latest/download/updates.json"
    }
  },
  "background": {
    "scripts": ["background.js"]
  },
  "permissions": [
    "accountsRead",
    "messagesRead",
    "messagesUpdate",
    "messagesTagsList",
    "compose",
    "compose.save",
    "nativeMessaging"
  ]
}
